{
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "zfp-advisor-bot-001",
  "packageName": "com.zfp.advisor",
  "developer": {
    "name": "ZFP Group",
    "websiteUrl": "https://zfp.com",
    "privacyUrl": "https://zfp.com/privacy",
    "termsOfUseUrl": "https://zfp.com/terms"
  },
  "name": {
    "short": "ZFP Advisor",
    "full": "ZFP Workforce Advisor"
  },
  "description": {
    "short": "AI workforce intelligence for ZFP leadership",
    "full": "Ask ZFP Advisor natural language questions about workforce data, billable utilization, project hours, and team performance. Bilingual Arabic and English."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#1B2A4A",
  "bots": [
    {
      "botId": "${MicrosoftAppId}",
      "scopes": ["personal", "team", "groupchat"],
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["${AZURE_APP_NAME}.azurewebsites.net"]
}
