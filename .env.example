# ── ZFP Advisor — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to git.

# ── AI (Required) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5

# ── Power BI Service Principal (Required) ─────────────────────────────────────
# Tenant, workspace, dataset IDs from your Power BI environment
POWERBI_TENANT_ID=your-azure-ad-tenant-id
POWERBI_CLIENT_ID=your-service-principal-app-id
POWERBI_CLIENT_SECRET=your-service-principal-client-secret
POWERBI_WORKSPACE_ID=d22cea18-4fd9-4655-b61f-ecfca0db3048
POWERBI_DATASET_ID=a577493b-6eb6-4061-acc3-942db4412edd

# ── Teams Bot (Optional — leave blank to disable) ─────────────────────────────
# Create a bot registration at https://dev.botframework.com/
MicrosoftAppId=
MicrosoftAppPassword=

# ── Azure Deployment ──────────────────────────────────────────────────────────
AZURE_APP_NAME=zfp-advisor
STATIC_WEB_APP_URL=https://your-swa-name.azurestaticapps.net

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
